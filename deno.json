{
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --allow-import src/main.ts",
    "webhook": "deno run --allow-net --allow-env --allow-import scripts/webhook.ts",
    "check": "deno check --allow-import src/main.ts src/persistence/migrate.ts scripts/webhook.ts tests/",
    "test": "deno test --allow-import --allow-env --allow-read --allow-write tests/",
    "test:pg": "deno test --allow-import --allow-env --allow-net --allow-read --allow-write tests/persistence_pg_test.ts",
    "migrate:pg": "deno run --allow-net --allow-env src/persistence/migrate.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "unstable": ["kv"],
  "imports": {
    "grammy": "npm:grammy@^1.46.0",
    "grammy/types": "npm:grammy@^1.46.0/types",
    "@grammyjs/storage-denokv": "jsr:@grammyjs/storage-denokv@^2.6.0",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "grammy-testing": "npm:grammy-testing@^0.26.0",
    "pg": "npm:pg@^8.23.0",
    "@types/pg": "npm:@types/pg@^8"
  },
  "lock": true,
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true
  },
  "fmt": { "singleQuote": true, "lineWidth": 100 },
  "lint": { "rules": { "include": ["no-explicit-any", "no-slow-types"] } }
}
